COMPANY_ACTIVITY_SUB_MAP = {
    "CONSTRUCTION": [
        "Барилга угсралтын үйл ажиллагаа",
        "Барилгын засвар, шинэчлэл",
        "Барилгын дотор заслын ажил",
    ],
    "ELECTRIC": [
        "Барилгын цахилгаан угсралтын ажил",
        "Гадна цахилгаан хангамжийн угсралт",
    ],
    "PLUMBING": [
        "Барилгын ус хангамж, ариутгах татуургын угсралт",
        "Гадна ус хангамж, ариутгах татуургын шугам угсралт",
    ],
    "HEAT_SUPPLY": [
        "Гадна дулаан хангамжийн шугам сүлжээ угсралт",
    ],
    "HVAC": [
        "Холбоо, дохиолол, автоматжуулалтын системийн угсралт",
    ],
    "COMM_ALARM": [
        "Галын дохиолол, унтраах системийн угсралт",
        "Хяналтын камер, хамгаалалтын системийн угсралт",
    ],
    "ENG_NETWORK": [
        "Инженерийн шугам сүлжээний угсралт",
        "Гадна инженерийн төв магистрал шугам сүлжээний угсралт",
