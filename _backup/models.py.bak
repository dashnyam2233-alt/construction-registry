class GovernmentOrganization(models.Model):
    name = models.CharField("Нэр", max_length=255)
    register_no = models.CharField("РД/Бүртгэлийн №", max_length=50, blank=True, default="")
    address = models.CharField("Хаяг", max_length=255, blank=True, default="")
    phone = models.CharField("Утас", max_length=50, blank=True, default="")
    email = models.EmailField("Имэйл", blank=True, default="")
    website = models.CharField("Вэб", max_length=255, blank=True, default="")
    note = models.TextField("Тайлбар", blank=True, default="")

    class Meta:
        verbose_name = "Салбарын төрийн байгууллага"
        verbose_name_plural = "Салбарын төрийн байгууллагууд"
        ordering = ("name",)

    def __str__(self) -> str:
        return self.name


class NonGovernmentOrganization(models.Model):
    name = models.CharField("Нэр", max_length=255)
    register_no = models.CharField("РД/Бүртгэлийн №", max_length=50, blank=True, default="")
    address = models.CharField("Хаяг", max_length=255, blank=True, default="")
    phone = models.CharField("Утас", max_length=50, blank=True, default="")
    email = models.EmailField("Имэйл", blank=True, default="")
    website = models.CharField("Вэб", max_length=255, blank=True, default="")
    note = models.TextField("Тайлбар", blank=True, default="")

    class Meta:
        verbose_name = "Салбарын төрийн бус байгууллага"
        verbose_name_plural = "Салбарын төрийн бус байгууллагууд"
        ordering = ("name",)

    def __str__(self) -> str:
        return self.name


class Company(models.Model):
    class ActivityType(models.TextChoices):
        DESIGN = "design", "Зураг төсөл"
        CONSTRUCTION = "construction", "Барилга угсралт"
        SUPPLY = "supply", "Материал нийлүүлэлт"
        CONSULTING = "consulting", "Зөвлөх үйлчилгээ"
        OTHER = "other", "Бусад"

    name = models.CharField("Компанийн нэр", max_length=255)
    register_no = models.CharField("РД/Бүртгэлийн №", max_length=50, blank=True, default="")

    # (хуучин) ангилал — хадгалж үлдэнэ
    activity_type = models.CharField(
        "Үйл ажиллагааны төрөл",
        max_length=32,
        choices=ActivityType.choices,
        default=ActivityType.OTHER,
    )

    # ✅ (шинэ) чиглэл + дэд сонголт
    activity_direction = models.CharField(
        "Үйл ажиллагааны чиглэл",
        max_length=50,
        choices=COMPANY_ACTIVITY_DIRECTION_CHOICES,
        blank=True,
        default="",
    )
    activity_sub_direction = models.CharField(
        "Дэд сонголт",
        max_length=120,
        blank=True,
        default="",
    )

    city = models.CharField("Хот/Аймаг", max_length=8, choices=CITY_CHOICES, blank=True, default="")
    district = models.CharField("Дүүрэг (УБ үед)", max_length=8, choices=UB_DISTRICT_CHOICES, blank=True, default="")
    address = models.CharField("Дэлгэрэнгүй хаяг", max_length=255, blank=True, default="")

    phone = models.CharField("Утас", max_length=50, blank=True, default="")
    email = models.EmailField("Имэйл", blank=True, default="")
    website = models.CharField("Вэб", max_length=255, blank=True, default="")
    note = models.TextField("Тайлбар", blank=True, default="")

    class Meta:
        verbose_name = "Компани"
        verbose_name_plural = "Компаниудын мэдээлэл"
        ordering = ("name",)

    def __str__(self) -> str:
        return self.name


class Worker(models.Model):
    class Profession(models.TextChoices):
        ENGINEER = "engineer", "Инженер"
        ARCHITECT = "architect", "Архитектор"
        FOREMAN = "foreman", "Даамал"
        ACCOUNTANT = "accountant", "Нягтлан"
        HR = "hr", "Хүний нөөц"
        MANAGER = "manager", "Менежер"
        WORKER = "worker", "Ажилчин"
        OTHER = "other", "Бусад"

    company = models.ForeignKey(
        Company,
        on_delete=models.PROTECT,
        related_name="workers",
        verbose_name="Харьяалах компани",
        null=True,
        blank=True,
    )

    responsible_role = models.CharField(
        "Хариуцсан ажил",
        max_length=50,
        choices=RESPONSIBLE_ROLE_CHOICES,
        blank=True,
        default="",
    )

    engineer_specialty = models.CharField(
        "Инженерийн төрөл",
        max_length=50,
        choices=ENGINEER_SPECIALTY_CHOICES,
        blank=True,
        default="",
    )

    last_name = models.CharField("Овог", max_length=100, blank=True, default="")
    first_name = models.CharField("Нэр", max_length=100)
    register_no = models.CharField("Регистр", max_length=20, blank=True, default="")
    phone = models.CharField("Утас", max_length=50, blank=True, default="")
    email = models.EmailField("Имэйл", blank=True, default="")

    facebook_url = models.URLField("Facebook хаяг", max_length=255, blank=True, default="")
    instagram_url = models.URLField("Instagram хаяг", max_length=255, blank=True, default="")
    viber = models.CharField("Viber хаяг/дугаар", max_length=100, blank=True, default="")

    city = models.CharField("Хот/Аймаг", max_length=8, choices=CITY_CHOICES, blank=True, default="")
    district = models.CharField("Дүүрэг (УБ үед)", max_length=8, choices=UB_DISTRICT_CHOICES, blank=True, default="")
    address = models.CharField("Дэлгэрэнгүй хаяг", max_length=255, blank=True, default="")

    birth_place_city = models.CharField("Төрсөн газар - Хот/Аймаг", max_length=8, choices=CITY_CHOICES, blank=True, default="")
    birth_place_sub = models.CharField("Төрсөн газар - Дүүрэг/Сум", max_length=64, blank=True, default="")

    birth_date = models.DateField("Төрсөн огноо", null=True, blank=True)
    start_work_date = models.DateField("Ажил эхэлсэн огноо", null=True, blank=True)

    profession = models.CharField(
        "Мэргэжил",
        max_length=32,
        choices=Profession.choices,
        default=Profession.OTHER,
    )

    note = models.TextField("Тайлбар", blank=True, default="")

    class Meta:
        verbose_name = "Ажилтан"
        verbose_name_plural = "Ажиллагсадын мэдээлэл"
        ordering = ("first_name", "last_name")

    def __str__(self) -> str:
        full = f"{self.last_name} {self.first_name}".strip()
        return full if full else self.first_name


class FamilyMember(models.Model):
    class RelationType(models.TextChoices):
        SPOUSE = "spouse", "Эхнэр/Нөхөр"
        CHILD = "child", "Хүүхэд"
        PARENT = "parent", "Эцэг/Эх"
        SIBLING = "sibling", "Ах/Эгч/Дүү"
        OTHER = "other", "Бусад"

    worker = models.ForeignKey(
        Worker,
        on_delete=models.CASCADE,
        related_name="family_members",
        verbose_name="Ажилтан",
    )
    relation_type = models.CharField(
        "Хамаарал",
        max_length=16,
        choices=RelationType.choices,
        default=RelationType.OTHER,
    )
    full_name = models.CharField("Овог нэр", max_length=255)
    birth_date = models.DateField("Төрсөн огноо", null=True, blank=True)
    phone = models.CharField("Утас", max_length=50, blank=True, default="")
    note = models.TextField("Тайлбар", blank=True, default="")

    class Meta:
        verbose_name = "Ажилтны хамаарал"
        verbose_name_plural = "Ажилтны хамаарал"
        ordering = ("worker", "full_name")

    def __str__(self) -> str:
        return f"{self.full_name} ({self.get_relation_type_display()})"


class AdminGroup(Group):
    class Meta:
        proxy = True
        app_label = "auth"
        verbose_name = "Админ"
        verbose_name_plural = "Админууд"
